{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "./index.ts",
    "./schemas/**/*.ts",
    "./domain/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}